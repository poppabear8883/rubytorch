{
  "name": "rubytorch-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prebuild": "node scripts/contrast.mjs",
    "contrast": "node scripts/contrast.mjs --write",
